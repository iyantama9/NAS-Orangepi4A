# Salin jadi .env (di Pi dan lokal), isi passwordnya.
POSTGRES_PASSWORD=ganti-password-ini

# Personal NAS: biarkan false. Ubah sementara menjadi true hanya untuk
# membuat akun pemilik pertama, lalu kembalikan ke false dan restart.
NAS_ALLOW_OWNER_BOOTSTRAP=false

# Opsional: Cloudflare Tunnel Token (untuk akses via domain publik tanpa public IP)
CLOUDFLARE_TUNNEL_TOKEN=
